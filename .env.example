# Variables d'environnement pour l'API Flashcard

# Port du serveur
PORT=3000

# Adresse du serveur
ADDRESS=localhost

# Nom du fichier de base de données SQLite (sera créé automatiquement)
DB_FILE_NAME=file:local.sqlite

# Secret JWT pour signer les tokens (IMPORTANT: Changez cette valeur en prod)
JWT_SECRET="secret_jwt_super_securise_a_changer"

# Durée de validité des tokens JWT (exemples: '1h', '7d', '30d')
JWT_EXPIRATION=7d

# URL du frontend (pour CORS)
FRONTEND_URL=http://localhost:5173
